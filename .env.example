# Copy to .env and fill in. .env is git-ignored and never leaves this machine.

# ── Core ─────────────────────────────────────────────────────────────────────
DATABASE_PATH=grades.db
SESSION_TTL_HOURS=168
CORS_ORIGINS=http://localhost:3000

# ── Deployment ───────────────────────────────────────────────────────────────
# Whether the session cookie carries `Secure`. Left blank it is inferred: every
# origin above must be loopback for the cookie to travel without it. Set it only
# for a deployment that cannot be read from the origins — a tunnel, a local TLS
# proxy.
COOKIE_SECURE=

# Hosts whose X-Forwarded-For may be believed, comma separated, or `*` for any.
# Blank trusts none, which is right until there IS a proxy. Behind one, leaving
# this blank gives every caller the proxy's address, and the sign-in lockout then
# keys on the email alone — which means anyone can lock anyone out. Set it when
# you deploy behind nginx, Caddy, Cloudflare or similar, and only then.
TRUSTED_PROXIES=

# Provider calls one account may make per hour. Every AI request is billed.
AI_MAX_CALLS_PER_HOUR=60

# ── LLM provider keys ────────────────────────────────────────────────────────
# The database stores only the NAME of these variables (ai_providers.api_key_env),
# never the value. A database leak exposes no credentials.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
# NVIDIA provider example for /admin/ai:
# endpoint: https://integrate.api.nvidia.com/v1
# model: deepseek-ai/deepseek-v4-flash
# params_json:
# {"temperature":0.6,"top_p":0.95,"max_tokens":4096,"chat_template_kwargs":{"thinking":true,"reasoning_effort":"high"}}
#
# Ollama provider example (no key):
# endpoint: http://localhost:11434/v1
# api_key_env: leave empty
#
# OmniRoute and Ollama run locally and usually need no key.
OMNIROUTE_API_KEY=
