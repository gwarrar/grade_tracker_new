# The package store lives in the repository, not in %LOCALAPPDATA%.
#
# Without this, `pnpm add` refuses every install: node_modules is linked from
# ../.pnpm-store and pnpm defaults to the global store, which it treats as a
# location change requiring a full reinstall. pnpm appends the store version
# itself, so this points at the parent of `v11`, not at `v11`.
store-dir=../.pnpm-store
